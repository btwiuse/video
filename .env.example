# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat           # V3, fast (recommended for storyboard)
DEEPSEEK_REASONING_MODEL=deepseek-reasoner  # R1, slower but deeper
DEEPSEEK_TIMEOUT=600                   # API timeout in seconds
DEEPSEEK_USE_REASONING=false           # Set to true for complex scripts
DEEPSEEK_MAX_CONCURRENCY=4              # Parallel Step 1 requests; lower if the API is unstable
DEEPSEEK_TOOL_MAX_ATTEMPTS=3            # Retries for malformed/interrupted tool-call JSON
DEEPSEEK_RETRY_BASE_DELAY_SEC=1         # Exponential retry base delay in seconds

# Image generation provider
# Options: flux, flux-ultra, sdxl, seedream, stepfun, comfyui, null
IMAGE_PROVIDER=flux
IMAGE_API_KEY=your-key-here              # Replicate token, Ark API key, or StepFun API key
COMFYUI_URL=http://localhost:8188
STEPFUN_MODEL=step-image-edit-2           # step-image-edit-2, step-2x-large, step-1x-medium
STEPFUN_BASE_URL=https://api.stepfun.com   # Override for proxies / custom StepFun-compatible gateways

# Video generation provider
# Options: tokenvoke, tokease, seedance (direct Ark API), null
VIDEO_PROVIDER=tokease
VIDEO_API_KEY=your-video-key-here              # TokenVoke / Tokease API key (or Ark key for seedance)

# Model name (shared across providers)
# Common Tokease models: seedance2.5-chaofen, seedance2.5, seedance2.5-huoshan,
#   seedance2.0-fast, seedance2.0-mini, seedance2.0-huoshan, seedance 2.0, ...
VIDEO_MODEL=seedance2.5-chaofen

# TokenVoke Seedance settings (when VIDEO_PROVIDER=tokenvoke)
TOKENVOKE_BASE_URL=https://overseas.tokenvoke.com
TOKENVOKE_MAX_DURATION_SEC=15
TOKENVOKE_MAX_IMAGES=9

# Tokease Seedance settings (when VIDEO_PROVIDER=tokease)
TOKEASE_BASE_URL=https://tokease.cn
TOKEASE_API_KEY=your-tokease-key-here          # Falls back to VIDEO_API_KEY when empty

# Public URL for image references (needed for video generation with reference images)
# Set to your server's public base URL, e.g. https://your-domain.com
PUBLIC_URL=https://film-pipeline-studio.up.railway.app

# Audio generation (dialogue / TTS)
# Options: elevenlabs, null
AUDIO_PROVIDER=null
AUDIO_API_KEY=your-key-here              # ElevenLabs API key (when AUDIO_PROVIDER=elevenlabs)

# Pipeline settings
OUTPUT_DIR=./output
